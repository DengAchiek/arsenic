DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.arsenicenergies.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://arsenicenergies.com,https://www.arsenicenergies.com,https://api.arsenicenergies.com
DJANGO_CORS_ALLOWED_ORIGINS=https://arsenicenergies.com,https://www.arsenicenergies.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SERVE_FRONTEND=False
DJANGO_FRONTEND_BUILD_DIR=../frontend

# PostgreSQL
DATABASE_URL=postgresql://arsenic_user:strong-password@localhost:5432/arsenic_energies

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
DJANGO_ALLOW_MOCK_CHECKOUT=False
FRONTEND_BASE_URL=https://arsenicenergies.com
BACKEND_BASE_URL=https://api.arsenicenergies.com
ORDER_SUCCESS_PATH=/checkout-success.html
ORDER_CANCEL_PATH=/shop.html
STRIPE_ALLOWED_COUNTRIES=US,KE,UG,TZ,RW,ET,NG,GH,ZA

# Email: SendGrid SMTP example
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.replace_me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Arsenic Energies <sales@arsenicenergies.com>
SALES_TEAM_EMAILS=sales@arsenicenergies.com

# Email: AWS SES SMTP alternative
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_HOST_USER=your-ses-smtp-username
# EMAIL_HOST_PASSWORD=your-ses-smtp-password

# Cloudflare R2/S3-compatible media storage for product uploads
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto
